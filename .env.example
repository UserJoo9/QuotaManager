# QuotaManager Docker Environment Configuration

# Timezone (e.g. Africa/Cairo, UTC, America/New_York, Europe/London)
TZ=Africa/Cairo

# Web Dashboard Port (default: 8080)
QUOTA_PORT=8080

# Gateway Network Configuration (optional - auto-detected or defaults used if omitted)
# LAN_IF=eth0
# CLIENT_IP=192.168.2.1
# CLIENT_NET=192.168.2.0/24
# POOL_START=192.168.2.100
# POOL_END=192.168.2.200
# WAN_GATEWAY=192.168.1.1
# UPSTREAM_DNS=8.8.8.8
