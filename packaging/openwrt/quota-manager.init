#!/bin/sh /etc/rc.common
# procd service for QuotaManager on OpenWrt
START=99
STOP=10
USE_PROCD=1
APP_DIR=/opt/QuotaManager
DATA_DIR=/overlay/quota-gateway   # persistent (extroot/overlay); /var is tmpfs

start_service() {
    [ -f /overlay/swapfile ] && swapon /overlay/swapfile 2>/dev/null
    mkdir -p "$DATA_DIR" /var/lib /var/log/quota-gateway
    if [ ! -L /var/lib/quota-gateway ]; then
        rm -rf /var/lib/quota-gateway
        ln -s "$DATA_DIR" /var/lib/quota-gateway
    fi
    procd_open_instance
    procd_set_param command /bin/sh -c "cd $APP_DIR && exec python3 run.py --config $APP_DIR/config.yaml"
    procd_set_param respawn 3600 10 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
