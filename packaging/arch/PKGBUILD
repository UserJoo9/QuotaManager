# Maintainer: Youssef Alkhodary <youssef.alkhodary@users.noreply.github.com>
# Local build from the release tarball:
#   makepkg -si    (with netrex-VER.tar.gz next to this file)
# The release workflow also publishes a ready-made .pkg.tar.zst.
# The pacman package keeps the name quota-manager for now: updaters older than 0.6.0
# run `pacman -U --noconfirm`, which answers NO to a package-conflict prompt, so a
# renamed (conflicting) package could not replace the installed one. Only the
# release FILE is named netrex-*. Rename the package itself once every box updates
# with 0.6.0+ (the updater can then pass --ask=4).
pkgname=quota-manager
pkgver=0.0.0
pkgrel=1
pkgdesc='Fair-split metered-internet quota gateway'
arch=('any')
url='https://github.com/UserJoo9/Netrex'
license=('MIT')
depends=('python>=3.10' 'python-pip' 'dnsmasq' 'nftables' 'iproute2' 'kmod' 'ppp' 'ca-certificates')
install=netrex.install
source=("netrex-${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/netrex-${pkgver}"
    install -d "$pkgdir/opt/quota-manager"
    for item in run.py requirements-linux.txt LICENSE core quota api web scripts bin; do
        [ -e "$item" ] && cp -a "$item" "$pkgdir/opt/quota-manager/"
    done
    chmod 755 "$pkgdir"/opt/quota-manager/scripts/*.sh
}
