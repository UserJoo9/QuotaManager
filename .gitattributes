# Auto detect text files and perform LF normalization
* text=auto

# Linux shell scripts and packaging configs must always use LF line endings
*.sh text eol=lf
*.bash text eol=lf
scripts/* text eol=lf
packaging/DEBIAN/* text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.nft text eol=lf
packaging/** text eol=lf

# Keep Vite HTML input/output identical on Windows and Linux.
frontend/index.html text eol=lf
web/index.html text eol=lf
web/app/*.js text eol=lf whitespace=-blank-at-eol
web/app/*.css text eol=lf
